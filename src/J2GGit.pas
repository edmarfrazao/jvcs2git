jvcs2git - git on the PATH: version, init (without -b: 'git init -q' +
'symbolic-ref HEAD', works with any git 2.x and ignores init.defaultBranch),
fast-import, checkout, check-ref-format.
git runs with stdin from a file (or NUL) and stdout+stderr to a temporary
file (no pipe deadlock).

-----------------------------------------------------------------------------*)

unit J2GGit;

{$I jedi.inc}
{$I compopt.inc}
{$WARN SYMBOL_PLATFORM OFF}

interface

uses
  System.SysUtils, System.Classes;

const
  J2G_MARKS_FILE = 'jvcs2git.marks';  // inside <repo>\.git (repository made by jvcs2git)

// runs 'git <args>' in AWorkDir ('' = current); stdout+stderr in AOutput.
// Returns the exit code, or -1 when git cannot be started (not on the PATH).
function J2GRunGit(const AArgs: array of string; const AWorkDir: string; out AOutput: string;
  const AStdInFile: string = ''): Integer;
// 'git --version' (e.g. 'git version 2.54.0.windows.1'); False when git is missing
function J2GGitVersion(out AVersion: string): Boolean;
// git init -q <dir> + git -C <dir> symbolic-ref HEAD refs/heads/<branch>; raises EJ2GError(12)
procedure J2GGitInitRepo(const ARepoDir, ABranch: string);
// git -C <dir> fast-import --quiet --export-marks=.git/jvcs2git.marks < stream; raises EJ2GError(12)
procedure J2GGitFastImport(const ARepoDir, AStreamFile: string);
// git -C <dir> checkout -q <branch>; raises EJ2GError(12)
procedure J2GGitCheckout(const ARepoDir, ABranch: string);
// git check-ref-format --branch <name> (ABranch) or refs/tags/<name>; False also when git is missing
function J2GGitCheckRefFormat(const AName: string; ABranch: Boolean): Boolean;
// <dir>\.git\jvcs2git.marks exists (repository generated by jvcs2git)
function J2GIsJvcs2GitRepo(const ARepoDir: string): Boolean;
// quotes one argument for CreateProcess (MSVCRT rules)
function J2GQuoteArg(const S: string): string;

implementation

uses
  Winapi.Windows, System.IOUtils, J2GModel;

function J2GQuoteArg(const S: string): string;
var
  I, BS: Integer;
  NeedQuote: Boolean;
begin
  NeedQuote := (S = '');
  for I := 1 to Length(S) do
    if CharInSet(S[I], [' ', #9, '"']) then
    begin
      NeedQuote := True;
      Break;
    end;
  if not NeedQuote then
    Exit(S);
  Result := '"';
  BS := 0;
  for I := 1 to Length(S) do
  begin
    if S[I] = '\' then
      Inc(BS)
    else if S[I] = '"' then
    begin
      Result := Result + StringOfChar('\', BS * 2 + 1) + '"';
      BS := 0;
    end
    else
    begin
      if BS > 0 then
        Result := Result + StringOfChar('\', BS);
      BS := 0;
      Result := Result + S[I];
    end;
  end;
  // trailing backslashes are doubled before the closing quote
  Result := Result + StringOfChar('\', BS * 2) + '"';
end;

function DecodeOutput(const B: TBytes): string;
begin
  // git writes UTF-8; invalid bytes become U+FFFD
  Result := TEncoding.UTF8.GetString(B);
end;

function J2GRunGit(const AArgs: array of string; const AWorkDir: string; out AOutput: string;
  const AStdInFile: string): Integer;
var
  Cmd, OutFile: string;
  SA: TSecurityAttributes;
  SI: TStartupInfo;
  PI: TProcessInformation;
  HOut, HIn: THandle;
  I: Integer;
  Code: DWORD;
  WorkDir: PChar;
begin
  AOutput := '';
  Result := -1;
  Cmd := 'git';
  for I := 0 to High(AArgs) do
    Cmd := Cmd + ' ' + J2GQuoteArg(AArgs[I]);
  OutFile := TPath.Combine(TPath.GetTempPath, Format('jvcs2git-git-%d-%d.txt', [GetCurrentProcessId, GetTickCount]));
  FillChar(SA, SizeOf(SA), 0);
  SA.nLength := SizeOf(SA);
  SA.bInheritHandle := True;
  HOut := CreateFile(PChar(OutFile), GENERIC_WRITE, FILE_SHARE_READ, @SA, CREATE_ALWAYS,
    FILE_ATTRIBUTE_TEMPORARY, 0);
  if HOut = INVALID_HANDLE_VALUE then
    raise EJ2GError.CreateFmt(J2G_EXIT_ENVIRONMENT, 'cannot create temporary file %s', [OutFile]);
  try
    if AStdInFile <> '' then
      HIn := CreateFile(PChar(AStdInFile), GENERIC_READ, FILE_SHARE_READ, @SA, OPEN_EXISTING,
        FILE_ATTRIBUTE_NORMAL, 0)
    else
      HIn := CreateFile('NUL', GENERIC_READ, FILE_SHARE_READ or FILE_SHARE_WRITE, @SA, OPEN_EXISTING,
        FILE_ATTRIBUTE_NORMAL, 0);
    if HIn = INVALID_HANDLE_VALUE then
      raise EJ2GError.CreateFmt(J2G_EXIT_ENVIRONMENT, 'cannot open %s', [AStdInFile]);
    try
      FillChar(SI, SizeOf(SI), 0);
      SI.cb := SizeOf(SI);
      SI.dwFlags := STARTF_USESTDHANDLES or STARTF_USESHOWWINDOW;
      SI.wShowWindow := SW_HIDE;
      SI.hStdInput := HIn;
      SI.hStdOutput := HOut;
      SI.hStdError := HOut;
      if AWorkDir <> '' then
        WorkDir := PChar(AWorkDir)
      else
        WorkDir := nil;
      UniqueString(Cmd);
      if CreateProcess(nil, PChar(Cmd), nil, nil, True, CREATE_NO_WINDOW, nil, WorkDir, SI, PI) then
      try
        WaitForSingleObject(PI.hProcess, INFINITE);
        if not GetExitCodeProcess(PI.hProcess, Code) then
          Code := DWORD(-1);
        Result := Integer(Code);
      finally
        CloseHandle(PI.hThread);
        CloseHandle(PI.hProcess);
      end;
    finally
      CloseHandle(HIn);
    end;
  finally
    CloseHandle(HOut);
    if FileExists(OutFile) then
    begin
      try
        AOutput := Trim(DecodeOutput(TFile.ReadAllBytes(OutFile)));
      except
        AOutput := '';
      end;
      System.SysUtils.DeleteFile(OutFile);
    end;
  end;
end;

function J2GGitVersion(out AVersion: string): Boolean;
begin
  Result := J2GRunGit(['--version'], '', AVersion) = 0;
  if not Result then
    AVersion := '';
end;

procedure CheckGit(ACode: Integer; const AWhat, AOutput: string);
begin
  if ACode = -1 then
    raise EJ2GError.Create(J2G_EXIT_ENVIRONMENT, 'git not found on the PATH (install Git for Windows)');
  if ACode <> 0 then
    raise EJ2GError.CreateFmt(J2G_EXIT_ENVIRONMENT, '%s failed (exit %d): %s', [AWhat, ACode, AOutput]);
end;

procedure J2GGitInitRepo(const ARepoDir, ABranch: string);
var
  Output: string;
begin
  ForceDirectories(ARepoDir);
  CheckGit(J2GRunGit(['init', '-q', ARepoDir], '', Output), 'git init', Output);
  CheckGit(J2GRunGit(['-C', ARepoDir, 'symbolic-ref', 'HEAD', 'refs/heads/' + ABranch], '', Output),
    'git symbolic-ref', Output);
end;

procedure J2GGitFastImport(const ARepoDir, AStreamFile: string);
var
  Output: string;
begin
  CheckGit(J2GRunGit(['-C', ARepoDir, 'fast-import', '--quiet', '--export-marks=.git/' + J2G_MARKS_FILE],
    '', Output, AStreamFile), 'git fast-import', Output);
end;

procedure J2GGitCheckout(const ARepoDir, ABranch: string);
var
  Output: string;
begin
  CheckGit(J2GRunGit(['-C', ARepoDir, 'checkout', '-q', ABranch], '', Output), 'git checkout', Output);
end;

function J2GGitCheckRefFormat(const AName: string; ABranch: Boolean): Boolean;
var
  Output: string;
begin
  if ABranch then
    Result := J2GRunGit(['check-ref-format', '--branch', AName], '', Output) = 0
  else
    Result := J2GRunGit(['check-ref-format', 'refs/tags/' + AName], '', Output) = 0;
end;

function J2GIsJvcs2GitRepo(const ARepoDir: string): Boolean;
begin
  Result := FileExists(IncludeTrailingPathDelimiter(ARepoDir) + '.git\' + J2G_MARKS_FILE);
end;

end.
