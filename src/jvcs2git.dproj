<Project xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
    <!-- jvcs2git.dproj - abrir na IDE (Delphi 13). Caminhos, defines e saidas:
         ..\tools\msbuild\jvcs2git.props (mantenha igual ao tools\compilar.bat).
         O jvcs2git.res e gerado pelo Pre-Build (brcc32 jvcs2git.rc). -->
    <PropertyGroup>
        <ProjectGuid>{A3D95E21-7C64-4F0B-8B1E-5C2D4E6F7A81}</ProjectGuid>
        <ProjectVersion>20.3</ProjectVersion>
        <FrameworkType>VCL</FrameworkType>
        <AppType>Application</AppType>
        <MainSource>jvcs2git.dpr</MainSource>
        <Base>True</Base>
        <Config Condition="'$(Config)'==''">Release</Config>
        <Platform Condition="'$(Platform)'==''">Win32</Platform>
        <TargetedPlatforms>1</TargetedPlatforms>
    </PropertyGroup>
    <Import Project="..\tools\msbuild\jvcs2git.props"/>
    <PropertyGroup Condition="'$(Config)'=='Base' or '$(Base)'!=''">
        <Base>true</Base>
    </PropertyGroup>
    <PropertyGroup Condition="('$(Platform)'=='Win32' and '$(Base)'=='true') or '$(Base_Win32)'!=''">
        <Base_Win32>true</Base_Win32>
        <CfgParent>Base</CfgParent>
        <Base>true</Base>
    </PropertyGroup>
    <PropertyGroup Condition="'$(Config)'=='Debug' or '$(Cfg_1)'!=''">
        <Cfg_1>true</Cfg_1>
        <CfgParent>Base</CfgParent>
        <Base>true</Base>
    </PropertyGroup>
    <PropertyGroup Condition="'$(Config)'=='Release' or '$(Cfg_2)'!=''">
        <Cfg_2>true</Cfg_2>
        <CfgParent>Base</CfgParent>
        <Base>true</Base>
    </PropertyGroup>
    <PropertyGroup Condition="'$(Base)'!=''">
        <SanitizedProjectName>jvcs2git</SanitizedProjectName>
        <DCC_Namespace>$(JvcsNamespaces);$(DCC_Namespace)</DCC_Namespace>
        <DCC_Define>$(J2GDefines);$(DCC_Define)</DCC_Define>
        <DCC_UnitSearchPath>$(J2GUnitPath);$(J2GLibDcu);$(J2GLibInc);$(JvcsExtraPath);$(DCC_UnitSearchPath)</DCC_UnitSearchPath>
        <DCC_IncludePath>$(MSBuildProjectDirectory);$(JvcsRoot)\src\comp\midware;$(J2GLibInc);$(DCC_IncludePath)</DCC_IncludePath>
        <DCC_ResourcePath>$(J2GLibRes);$(DCC_ResourcePath)</DCC_ResourcePath>
        <DCC_ExeOutput>$(J2GOutDir)</DCC_ExeOutput>
        <DCC_DcuOutput>$(J2GDcuDir)</DCC_DcuOutput>
        <DCC_CodePage>1252</DCC_CodePage>
        <DCC_Hints>false</DCC_Hints>
        <DCC_E>false</DCC_E>
        <DCC_N>false</DCC_N>
        <DCC_S>false</DCC_S>
        <DCC_F>false</DCC_F>
        <DCC_K>false</DCC_K>
        <DCC_ConsoleTarget>false</DCC_ConsoleTarget>
        <VerInfo_IncludeVerInfo>false</VerInfo_IncludeVerInfo>
        <VerInfo_Locale>1046</VerInfo_Locale>
        <Manifest_File>None</Manifest_File>
        <PreBuildEvent>cd /d "$(MSBuildProjectDirectory)" &amp;&amp; "$(BDS)\bin\brcc32.exe" -fo"jvcs2git.res" "jvcs2git.rc"</PreBuildEvent>
        <PostBuildEvent>$(J2GPostBuild)</PostBuildEvent>
    </PropertyGroup>
    <PropertyGroup Condition="'$(Cfg_1)'!=''">
        <DCC_Define>DEBUG;$(DCC_Define)</DCC_Define>
        <DCC_DebugDCUs>true</DCC_DebugDCUs>
        <DCC_Optimize>false</DCC_Optimize>
        <DCC_IntegerOverflowCheck>true</DCC_IntegerOverflowCheck>
        <DCC_RangeChecking>true</DCC_RangeChecking>
        <DCC_AssertionsAtRuntime>true</DCC_AssertionsAtRuntime>
        <DCC_DebugInformation>2</DCC_DebugInformation>
        <DCC_LocalDebugSymbols>true</DCC_LocalDebugSymbols>
        <DCC_SymbolReferenceInfo>2</DCC_SymbolReferenceInfo>
        <DCC_DebugInfoInExe>true</DCC_DebugInfoInExe>
    </PropertyGroup>
    <PropertyGroup Condition="'$(Cfg_2)'!=''">
        <DCC_Define>RELEASE;$(DCC_Define)</DCC_Define>
        <DCC_Optimize>true</DCC_Optimize>
        <DCC_IntegerOverflowCheck>false</DCC_IntegerOverflowCheck>
        <DCC_RangeChecking>false</DCC_RangeChecking>
        <DCC_AssertionsAtRuntime>false</DCC_AssertionsAtRuntime>
        <DCC_DebugInformation>0</DCC_DebugInformation>
        <DCC_LocalDebugSymbols>false</DCC_LocalDebugSymbols>
        <DCC_SymbolReferenceInfo>0</DCC_SymbolReferenceInfo>
    </PropertyGroup>
    <ItemGroup>
        <DelphiCompile Include="$(MainSource)">
            <MainSource>MainSource</MainSource>
        </DelphiCompile>
        <DCCReference Include="J2GModel.pas"/>
        <DCCReference Include="J2GOptions.pas"/>
        <DCCReference Include="J2GIdentity.pas"/>
        <DCCReference Include="J2GReport.pas"/>
        <DCCReference Include="J2GSession.pas"/>
        <DCCReference Include="J2GFetch.pas"/>
        <DCCReference Include="J2GPaths.pas"/>
        <DCCReference Include="J2GGrouping.pas"/>
        <DCCReference Include="J2GAuthors.pas"/>
        <DCCReference Include="J2GBlob.pas"/>
        <DCCReference Include="J2GFastImport.pas"/>
        <DCCReference Include="J2GGit.pas"/>
        <DCCReference Include="J2GExport.pas"/>
        <DCCReference Include="J2GMain.pas">
            <Form>J2GMainForm</Form>
        </DCCReference>
        <BuildConfiguration Include="Base">
            <Key>Base</Key>
        </BuildConfiguration>
        <BuildConfiguration Include="Debug">
            <Key>Cfg_1</Key>
            <CfgParent>Base</CfgParent>
        </BuildConfiguration>
        <BuildConfiguration Include="Release">
            <Key>Cfg_2</Key>
            <CfgParent>Base</CfgParent>
        </BuildConfiguration>
    </ItemGroup>
    <ProjectExtensions>
        <Borland.Personality>Delphi.Personality.12</Borland.Personality>
        <Borland.ProjectType>Application</Borland.ProjectType>
        <BorlandProject>
            <Delphi.Personality>
                <Source>
                    <Source Name="MainSource">jvcs2git.dpr</Source>
                </Source>
            </Delphi.Personality>
            <Platforms>
                <Platform value="Win32">True</Platform>
            </Platforms>
        </BorlandProject>
        <ProjectFileVersion>12</ProjectFileVersion>
    </ProjectExtensions>
    <Import Project="$(BDS)\Bin\CodeGear.Delphi.Targets" Condition="Exists('$(BDS)\Bin\CodeGear.Delphi.Targets')"/>
    <Import Project="$(APPDATA)\Embarcadero\$(BDSAPPDATABASEDIR)\$(PRODUCTVERSION)\UserTools.proj" Condition="Exists('$(APPDATA)\Embarcadero\$(BDSAPPDATABASEDIR)\$(PRODUCTVERSION)\UserTools.proj')"/>
</Project>
