jvcs2git - TJ2GOptions: single source of truth of the options. The CLI
(J2GCli) and the window (J2GMain) fill the same record.
Never holds the password. The Blowfish key (EncodeKey) is kept only as bytes
and never written to log, JSON or report.

-----------------------------------------------------------------------------*)

unit J2GOptions;

{$I jedi.inc}
{$I compopt.inc}

interface

uses
  System.SysUtils, System.Classes;

type
  TJ2GCommand = (jcExport, jcList, jcDryRun, jcSelfTest, jcHelp);
  TJ2GLabelMode = (lmTag, lmNone);
  TJ2GCommitterDate = (cdMonotonic, cdOriginal);
  TJ2GKeySource = (ksNone, ksRegistry, ksFile, ksStdin);

  TJ2GOptions = record
    Command: TJ2GCommand;
    SelfTestName: string;      // 'paths' | 'blob'
    // connection
    Identity: string;          // name of HKCU\Software\JEDI\JEDIVCS\Identities\<name>
    Host: string;
    Port: string;              // string as TJVCSConnection.Port
    User: string;
    JvcsBranch: string;        // JEDI VCS branch ('' = HEAD)
    // selection
    Projects: TArray<string>;  // names or IDs
    AllProjects: Boolean;
    IncludeDeleted: Boolean;
    SkipHidden: Boolean;
    // output
    OutDir: string;
    BranchName: string;        // git branch, default 'main'
    Force: Boolean;            // recreate <out>\<repo> if generated by jvcs2git
    NoGit: Boolean;            // only write the .fast-import stream
    KeepCache: Boolean;
    LogFile: string;           // default <out>\jvcs2git.log
    AuthorsFile: string;       // default <out>\autores.txt
    EmailDomain: string;       // default jedivcs.local
    // history
    GroupMinutes: Integer;     // default 10; 0 with NoGroup
    NoGroup: Boolean;
    GroupMaxSpanHours: Integer; // default 168 = 7 days (file dates)
    LocalTime: Boolean;
    CommitterDate: TJ2GCommitterDate;
    Root: string;
    NoDfmText: Boolean;
    Labels: TJ2GLabelMode;
    NoLog: Boolean;            // do not read the server log (dates by file time)
    NoAttributes: Boolean;     // no initial .gitattributes commit
    IgnoreCrc: Boolean;
    StrictCase: Boolean;
    BlobTimeout: Cardinal;     // ms, default 120000
    // Blowfish key: bytes only
    KeySource: TJ2GKeySource;
    EncodeKeyFile: string;
    NoEncodeKey: Boolean;
    EncodeKeyStdin: Boolean;
    EncodeKey: TBytes;
    // console
    Json: Boolean;
    Quiet: Boolean;
    // warnings found while parsing (e.g. host overriding the identity)
    ParseWarnings: TArray<string>;
    procedure SetDefaults;
    procedure AddWarning(const AMsg: string);
    procedure ClearKey;
    function EffectiveLogFile: string;
    function EffectiveAuthorsFile: string;
    // checks that do not need the server; False + message = usage error (2)
    function Validate(out AMsg: string): Boolean;
  end;

function J2GCommandName(ACommand: TJ2GCommand): string;
// splits 'host:port'
procedure J2GSplitHostPort(const AValue: string; out AHost, APort: string);
// True if APath is ADir or inside it (case-insensitive, expanded)
function J2GPathIsInside(const APath, ADir: string): Boolean;

implementation

function J2GCommandName(ACommand: TJ2GCommand): string;
begin
  case ACommand of
    jcList:     Result := 'list';
    jcDryRun:   Result := 'dryrun';
    jcSelfTest: Result := 'selftest';
    jcHelp:     Result := 'help';
  else
    Result := 'export';
  end;
end;

procedure J2GSplitHostPort(const AValue: string; out AHost, APort: string);
var
  P: Integer;
begin
  AHost := Trim(AValue);
  APort := '';
  P := LastDelimiter(':', AHost);
  if P > 0 then
  begin
    APort := Copy(AHost, P + 1, MaxInt);
    AHost := Copy(AHost, 1, P - 1);
  end;
end;

function J2GPathIsInside(const APath, ADir: string): Boolean;
var
  P, D: string;
begin
  if (APath = '') or (ADir = '') then
    Exit(False);
  P := IncludeTrailingPathDelimiter(ExpandFileName(APath));
  D := IncludeTrailingPathDelimiter(ExpandFileName(ADir));
  Result := SameText(Copy(P, 1, Length(D)), D);
end;

{ TJ2GOptions }

procedure TJ2GOptions.AddWarning(const AMsg: string);
begin
  SetLength(ParseWarnings, Length(ParseWarnings) + 1);
  ParseWarnings[High(ParseWarnings)] := AMsg;
end;

procedure TJ2GOptions.ClearKey;
begin
  if Length(EncodeKey) > 0 then
    FillChar(EncodeKey[0], Length(EncodeKey), 0);
  EncodeKey := nil;
end;

function TJ2GOptions.EffectiveAuthorsFile: string;
begin
  if AuthorsFile <> '' then
    Result := ExpandFileName(AuthorsFile)
  else if OutDir <> '' then
    Result := IncludeTrailingPathDelimiter(ExpandFileName(OutDir)) + 'autores.txt'
  else
    Result := '';
end;

function TJ2GOptions.EffectiveLogFile: string;
begin
  if LogFile <> '' then
    Result := ExpandFileName(LogFile)
  else if OutDir <> '' then
    Result := IncludeTrailingPathDelimiter(ExpandFileName(OutDir)) + 'jvcs2git.log'
  else
    Result := '';
end;

procedure TJ2GOptions.SetDefaults;
begin
  Self := Default(TJ2GOptions);
  Command := jcExport;
  Port := '';
  BranchName := 'main';
  EmailDomain := 'jedivcs.local';
  GroupMinutes := 10;
  GroupMaxSpanHours := 168;
  CommitterDate := cdMonotonic;
  Labels := lmTag;
  BlobTimeout := 120000;
  KeySource := ksNone;
end;

function TJ2GOptions.Validate(out AMsg: string): Boolean;
begin
  AMsg := '';
  if Command in [jcExport, jcDryRun] then
  begin
    if (Length(Projects) = 0) and not AllProjects then
      AMsg := 'missing -project <name|id> or -all'
    else if (Length(Projects) > 0) and AllProjects then
      AMsg := '-project and -all are mutually exclusive'
    else if (Command = jcExport) and (OutDir = '') then
      AMsg := 'missing -out <folder>'
    else if NoGroup and (GroupMinutes <> 10) and (GroupMinutes <> 0) then
      AMsg := '-group and -nogroup are mutually exclusive'
    else if (GroupMinutes < 0) or (GroupMaxSpanHours < 0) then
      AMsg := 'invalid -group / -group-maxspan value'
    else if BranchName = '' then
      AMsg := 'invalid -branch-name'
    else if (EncodeKeyFile <> '') and (OutDir <> '') and J2GPathIsInside(EncodeKeyFile, OutDir) then
      AMsg := '-encodekey-file must not be inside the -out folder'
    else if ((EncodeKeyFile <> '') or EncodeKeyStdin) and NoEncodeKey then
      AMsg := '-noencodekey cannot be combined with -encodekey-file/-encodekey-stdin'
    else if (EncodeKeyFile <> '') and EncodeKeyStdin then
      AMsg := '-encodekey-file and -encodekey-stdin are mutually exclusive';
  end;
  if (AMsg = '') and (Command <> jcSelfTest) and (Command <> jcHelp) then
    if (Identity = '') and (Host = '') then
      AMsg := 'missing <host[:port]> or -identity <name>';
  Result := AMsg = '';
end;

end.
